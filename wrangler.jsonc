{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "that-boy-needs-p2p",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://anj1.github.io/,http://localhost:4173,http://localhost:5173"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "PairingRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PairingRoom"] }
  ],
  "ratelimits": [
    { "name": "PAIRING_LIMIT", "namespace_id": "41001", "simple": { "limit": 20, "period": 60 } }
  ]
}
